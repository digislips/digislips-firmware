// Per-device credentials — copy this file to config.h and fill in real values.
// config.h is gitignored and must never be committed.

#pragma once

// WiFi credentials are provisioned at runtime via the captive portal (issue #18).
// They are stored in NVS (creds namespace) and NOT compiled into the binary.

// Each physical device gets its own ID — change per unit deployed
#define TILL_ID        "TILL-XX"

// Supabase
#define SUPABASE_URL   "https://eivctqjisodfhaitzyiq.supabase.co"
#define SUPABASE_ANON  "YOUR_SUPABASE_ANON_KEY"

// Each physical device gets its own token — generated via provision_device() in Supabase
#define DEVICE_TOKEN   "YOUR_DEVICE_TOKEN"
#define DEVICE_ID      "YOUR_DEVICE_UUID"
#define MERCHANT_ID    "YOUR_MERCHANT_UUID"

// QR code base URL — phone app will open https://digislips.co.za/slip/<slip_uuid>
#define QR_BASE_URL    "https://digislips.co.za/slip/"

// NTP
#define NTP_SERVER     "pool.ntp.org"
#define TZ_OFFSET      7200  // UTC+2 (SAST) in seconds
